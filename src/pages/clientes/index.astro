---
import Base from "../../layouts/Base.astro";
import { loadClientes, loadVentas, loadAbonos } from "../../lib/domain";
import { saldoVenta } from "../../lib/venta-utils";
import { pesos } from "../../lib/format";
const [clientes, ventas, abonos] = await Promise.all([loadClientes(), loadVentas(), loadAbonos()]);
const ventasPorCliente = new Map<string, typeof ventas>();
for (const v of ventas) {
  const arr = ventasPorCliente.get(v.clienteId) ?? [];
  arr.push(v); ventasPorCliente.set(v.clienteId, arr);
}
---
<Base title="Clientes">
  <div class="flex justify-between items-center mb-4">
    <h1 class="text-3xl font-extrabold tracking-tight">Clientes ({clientes.length})</h1>
    <a href="/clientes/nuevo" class="h-11 rounded-2xl bg-primary px-4 grid place-items-center text-sm font-bold text-primary-foreground shadow-lg shadow-primary/30">+ Nuevo cliente</a>
  </div>
  <div class="glass rounded-3xl overflow-hidden">
    <table class="w-full text-sm">
      <thead class="border-b border-border">
        <tr class="font-mono text-[11px] uppercase tracking-wider text-muted-foreground">
          <th class="px-4 py-3 text-left">ID</th>
          <th class="px-4 py-3 text-left">Nombre</th>
          <th class="px-4 py-3 text-left">Teléfono</th>
          <th class="px-4 py-3 text-left">Dirección</th>
          <th class="px-4 py-3 text-center">Lotes</th>
          <th class="px-4 py-3 text-right">Saldo total</th>
          <th class="px-4 py-3 text-left">Lotes</th>
        </tr>
      </thead>
      <tbody>
        {clientes.map((c) => {
          const vs = ventasPorCliente.get(c.clienteId) ?? [];
          const totalSaldo = vs.reduce((s, v) => s + saldoVenta(v, abonos), 0);
          return (
            <tr class="border-b border-border/50 last:border-0 hover:bg-white/40">
              <td class="px-4 py-3 font-mono">{c.clienteId}</td>
              <td class="px-4 py-3 font-semibold">{c.nombre}</td>
              <td class="px-4 py-3 font-mono text-xs">{c.telefono || "—"}</td>
              <td class="px-4 py-3 text-xs">{c.direccion || "—"}</td>
              <td class="px-4 py-3 text-center font-mono">{vs.length}</td>
              <td class={`px-4 py-3 text-right font-mono font-semibold ${totalSaldo <= 0 ? "text-disponible" : "text-primary"}`}>{vs.length ? pesos(totalSaldo) : "—"}</td>
              <td class="px-4 py-3">
                <div class="flex flex-wrap gap-1">
                  {vs.map((v) => (
                    <a href={`/?lote=${v.loteId}`} class="rounded-lg bg-neutral-100 hover:bg-primary hover:text-primary-foreground border border-border px-2 py-0.5 font-mono text-[10px] font-semibold transition">
                      {v.loteId}
                    </a>
                  ))}
                  {vs.length === 0 && <span class="text-muted-foreground text-xs">—</span>}
                </div>
              </td>
            </tr>
          );
        })}
      </tbody>
    </table>
  </div>
</Base>
