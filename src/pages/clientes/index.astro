---
import Base from "../../layouts/Base.astro";
import { loadClientes } from "../../lib/domain";
const clientes = await loadClientes();
---
<Base title="Clientes">
  <div class="mb-4 flex flex-wrap items-center justify-between gap-3">
    <h1 class="text-3xl font-extrabold tracking-tight">Clientes ({clientes.length})</h1>
    <a href="/clientes/nuevo" class="h-11 rounded-2xl bg-primary px-4 grid place-items-center text-sm font-bold text-primary-foreground shadow-lg shadow-primary/30">+ Nuevo cliente</a>
  </div>
  <div class="glass rounded-3xl overflow-hidden">
    <table class="w-full text-sm">
      <thead class="border-b border-border">
        <tr class="font-mono text-[11px] uppercase tracking-wider text-muted-foreground">
          <th class="px-5 py-3 text-left">ID</th>
          <th class="px-5 py-3 text-left">Nombre</th>
          <th class="px-5 py-3 text-left">Teléfono</th>
          <th class="px-5 py-3 text-left">Dirección</th>
        </tr>
      </thead>
      <tbody>
        {clientes.map((c) => (
          <tr class="border-b border-border/50 last:border-0 hover:bg-white/40">
            <td class="px-5 py-3 font-mono">{c.clienteId}</td>
            <td class="px-5 py-3 font-semibold">{c.nombre}</td>
            <td class="px-5 py-3 font-mono text-xs">{c.telefono || "—"}</td>
            <td class="px-5 py-3 text-xs">{c.direccion || "—"}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
</Base>
