---
import Base from "../../layouts/Base.astro";
import { actions } from "astro:actions";
const result = Astro.getActionResult(actions.crearCliente);
if (result && !result.error) return Astro.redirect(`/clientes?nuevo=${result.data.clienteId}`);
---
<Base title="Nuevo cliente">
  <form method="POST" action={actions.crearCliente} class="glass mx-auto max-w-md rounded-3xl p-6 space-y-4">
    <h1 class="text-2xl font-extrabold tracking-tight">Nuevo cliente</h1>
    <label class="block">
      <span class="font-mono text-[11px] uppercase tracking-wider text-muted-foreground">Nombre</span>
      <input name="nombre" required class="glass-soft w-full mt-1 h-11 rounded-2xl px-3 text-sm outline-none focus:ring-2 focus:ring-ring" autofocus />
    </label>
    <label class="block">
      <span class="font-mono text-[11px] uppercase tracking-wider text-muted-foreground">Teléfono</span>
      <input name="telefono" type="tel" class="glass-soft w-full mt-1 h-11 rounded-2xl px-3 text-sm outline-none focus:ring-2 focus:ring-ring" />
    </label>
    <label class="block">
      <span class="font-mono text-[11px] uppercase tracking-wider text-muted-foreground">Dirección</span>
      <input name="direccion" class="glass-soft w-full mt-1 h-11 rounded-2xl px-3 text-sm outline-none focus:ring-2 focus:ring-ring" />
    </label>
    <label class="block">
      <span class="font-mono text-[11px] uppercase tracking-wider text-muted-foreground">Notas</span>
      <textarea name="notas" rows="2" class="glass-soft w-full mt-1 rounded-2xl px-3 py-2 text-sm outline-none focus:ring-2 focus:ring-ring"></textarea>
    </label>
    {result?.error && <p class="text-destructive text-sm">{result.error.message}</p>}
    <button type="submit" class="w-full h-11 rounded-2xl bg-primary text-sm font-bold text-primary-foreground shadow-lg shadow-primary/30">Guardar</button>
  </form>
</Base>
