---
import Base from "../../layouts/Base.astro";
import { actions } from "astro:actions";
const result = Astro.getActionResult(actions.crearCliente);
if (result && !result.error) return Astro.redirect(`/clientes?nuevo=${result.data.clienteId}`);
---
<Base title="Nuevo cliente">
  <form method="POST" action={actions.crearCliente} class="max-w-md space-y-4">
    <h1 class="text-2xl font-bold">Nuevo cliente</h1>
    <label class="block">
      <span class="text-sm opacity-70">Nombre</span>
      <input name="nombre" required class="w-full mt-1 p-2 bg-neutral-800 rounded" autofocus />
    </label>
    <label class="block">
      <span class="text-sm opacity-70">Teléfono</span>
      <input name="telefono" type="tel" class="w-full mt-1 p-2 bg-neutral-800 rounded" />
    </label>
    <label class="block">
      <span class="text-sm opacity-70">Dirección</span>
      <input name="direccion" class="w-full mt-1 p-2 bg-neutral-800 rounded" />
    </label>
    <label class="block">
      <span class="text-sm opacity-70">Notas</span>
      <textarea name="notas" rows="2" class="w-full mt-1 p-2 bg-neutral-800 rounded"></textarea>
    </label>
    {result?.error && <p class="text-red-400">{result.error.message}</p>}
    <button type="submit" class="w-full py-3 rounded bg-emerald-600 hover:bg-emerald-500 font-semibold">Guardar</button>
  </form>
</Base>
