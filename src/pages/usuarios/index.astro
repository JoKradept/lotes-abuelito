---
import Base from "../../layouts/Base.astro";
import { UsuariosPanel } from "../../components/UsuariosPanel";

const MOTOR_URL = (
  (typeof process !== "undefined" && process.env?.MOTOR_URL) ||
  "http://localhost:3031/v1"
).replace(/\/$/, "");
const MOTOR_TOKEN =
  (typeof process !== "undefined" && process.env?.MOTOR_TOKEN) ||
  "O13xxar6WuBH5eCG6tZ7Hr5aFjMN24EBNGUkc47hnCo";

let usuariosIniciales: any[] = [];
try {
  const res = await fetch(`${MOTOR_URL}/_meta/users`, {
    headers: { Authorization: `Bearer ${MOTOR_TOKEN}` },
  });
  if (res.ok) {
    usuariosIniciales = await res.json();
  }
} catch (e) {
  console.error("Error al cargar usuarios iniciales en SSR:", e);
}
---
<Base title="Gestión de Usuarios y Roles — Cumbres de Tiripetío">
  <div class="mb-6 flex flex-wrap items-center justify-between gap-4">
    <div>
      <div class="flex items-center gap-2">
        <h1 class="text-3xl font-extrabold tracking-tight">Usuarios y Permisos</h1>
        <span class="inline-flex items-center gap-1.5 rounded-full bg-amber-100 px-3 py-0.5 font-mono text-xs font-semibold text-amber-800 ring-1 ring-inset ring-amber-600/20">
          Panel de Dueño
        </span>
      </div>
      <p class="text-sm text-muted-foreground mt-1">
        Administración central de cuentas, asignación de roles y control de acceso al sistema.
      </p>
    </div>
  </div>

  <UsuariosPanel client:load usuariosIniciales={usuariosIniciales} />
</Base>
