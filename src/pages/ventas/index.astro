---
import Base from "../../layouts/Base.astro";
import { loadVentas, loadClientes, loadAbonos, saldoVenta } from "../../lib/domain";
const [ventas, clientes, abonos] = await Promise.all([loadVentas(), loadClientes(), loadAbonos()]);
const clienteMap = new Map(clientes.map((c) => [c.clienteId, c]));
const rows = [...ventas].sort((a, b) => b.fecha.localeCompare(a.fecha));
---
<Base title="Ventas">
  <h1 class="text-2xl font-bold mb-4">Ventas ({rows.length})</h1>
  {rows.length === 0 ? (
    <p class="text-neutral-500">Aún no hay ventas registradas.</p>
  ) : (
    <table class="w-full text-sm">
      <thead class="bg-neutral-900 text-left">
        <tr><th class="p-2">ID</th><th class="p-2">Lote</th><th class="p-2">Cliente</th><th class="p-2">Fecha</th><th class="p-2">Precio</th><th class="p-2">Saldo</th></tr>
      </thead>
      <tbody>
        {rows.map((v) => {
          const c = clienteMap.get(v.clienteId);
          const saldo = saldoVenta(v, abonos);
          return (
            <tr class="border-b border-neutral-800 hover:bg-neutral-900">
              <td class="p-2 font-mono">{v.ventaId}</td>
              <td class="p-2 font-mono"><a href={`/lotes/${v.loteId}`} class="hover:underline">{v.loteId}</a></td>
              <td class="p-2">{c?.nombre ?? v.clienteId}</td>
              <td class="p-2">{v.fecha}</td>
              <td class="p-2">${v.precioFinal.toLocaleString("es-MX")}</td>
              <td class={`p-2 font-semibold ${saldo <= 0 ? "text-emerald-400" : "text-orange-400"}`}>
                ${saldo.toLocaleString("es-MX")}
              </td>
            </tr>
          );
        })}
      </tbody>
    </table>
  )}
</Base>
