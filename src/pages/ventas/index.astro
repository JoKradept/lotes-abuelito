---
import Base from "../../layouts/Base.astro";
import { loadVentas, loadClientes, loadAbonos, saldoVenta } from "../../lib/domain";
import { pesos } from "../../lib/format";
const [ventas, clientes, abonos] = await Promise.all([loadVentas(), loadClientes(), loadAbonos()]);
const clienteMap = new Map(clientes.map((c) => [c.clienteId, c]));
const rows = [...ventas].sort((a, b) => b.fecha.localeCompare(a.fecha));
---
<Base title="Ventas">
  <h1 class="text-3xl font-extrabold tracking-tight mb-4">Ventas ({rows.length})</h1>
  {rows.length === 0 ? (
    <div class="glass rounded-3xl p-10 text-center text-muted-foreground">Aún no hay ventas registradas.</div>
  ) : (
    <div class="glass rounded-3xl overflow-hidden">
      <table class="w-full text-sm">
        <thead class="border-b border-border">
          <tr class="font-mono text-[11px] uppercase tracking-wider text-muted-foreground">
            <th class="px-5 py-3 text-left">ID</th>
            <th class="px-5 py-3 text-left">Lote</th>
            <th class="px-5 py-3 text-left">Cliente</th>
            <th class="px-5 py-3 text-left">Fecha</th>
            <th class="px-5 py-3 text-left">Precio</th>
            <th class="px-5 py-3 text-left">Saldo</th>
          </tr>
        </thead>
        <tbody>
          {rows.map((v) => {
            const c = clienteMap.get(v.clienteId);
            const saldo = saldoVenta(v, abonos);
            return (
              <tr class="border-b border-border/50 last:border-0 hover:bg-white/40">
                <td class="px-5 py-3 font-mono">{v.ventaId}</td>
                <td class="px-5 py-3 font-mono font-semibold"><a href={`/lotes/${v.loteId}`} class="hover:text-primary">{v.loteId}</a></td>
                <td class="px-5 py-3">{c?.nombre ?? v.clienteId}</td>
                <td class="px-5 py-3 font-mono text-xs">{v.fecha}</td>
                <td class="px-5 py-3 font-mono">{pesos(v.precioFinal)}</td>
                <td class={`px-5 py-3 font-mono font-semibold ${saldo <= 0 ? "text-disponible" : "text-primary"}`}>{pesos(saldo)}</td>
              </tr>
            );
          })}
        </tbody>
      </table>
    </div>
  )}
</Base>
