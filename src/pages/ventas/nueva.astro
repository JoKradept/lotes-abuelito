---
import Base from "../../layouts/Base.astro";
import { loadLotes, loadClientes } from "../../lib/domain";
import { actions } from "astro:actions";
const [lotes, clientes] = await Promise.all([loadLotes(), loadClientes()]);
const disponibles = lotes.filter((l) => l.estado === "Disponible" || l.estado === "Apartado");
const loteSel = Astro.url.searchParams.get("loteId") ?? "";
const result = Astro.getActionResult(actions.crearVenta);
if (result && !result.error) return Astro.redirect(`/lotes/${result.data.loteId ?? loteSel}`);
---
<Base title="Nueva venta">
  <form method="POST" action={actions.crearVenta} class="glass mx-auto max-w-md rounded-3xl p-6 space-y-4">
    <h1 class="text-2xl font-extrabold tracking-tight">Registrar venta</h1>

    <label class="block">
      <span class="font-mono text-[11px] uppercase tracking-wider text-muted-foreground">Lote</span>
      <select name="loteId" required class="glass-soft w-full mt-1 h-11 rounded-2xl px-3 text-sm outline-none focus:ring-2 focus:ring-ring">
        {disponibles.map((l) => (
          <option value={l.loteId} selected={l.loteId === loteSel}>
            {l.loteId} — {l.frente}×{l.fondo}m — {l.estado}
          </option>
        ))}
      </select>
    </label>

    <label class="block">
      <span class="font-mono text-[11px] uppercase tracking-wider text-muted-foreground">Cliente</span>
      <select name="clienteId" required class="glass-soft w-full mt-1 h-11 rounded-2xl px-3 text-sm outline-none focus:ring-2 focus:ring-ring">
        {clientes.map((c) => (
          <option value={c.clienteId}>{c.clienteId} — {c.nombre}</option>
        ))}
      </select>
      <a href="/clientes/nuevo" class="mt-1 inline-block font-mono text-[11px] text-accent hover:underline">+ Nuevo cliente</a>
    </label>

    <label class="block">
      <span class="font-mono text-[11px] uppercase tracking-wider text-muted-foreground">Fecha</span>
      <input type="date" name="fecha" required value={new Date().toISOString().slice(0, 10)} class="glass-soft w-full mt-1 h-11 rounded-2xl px-3 text-sm outline-none focus:ring-2 focus:ring-ring" />
    </label>

    <div class="grid grid-cols-2 gap-3">
      <label class="block">
        <span class="font-mono text-[11px] uppercase tracking-wider text-muted-foreground">Precio final</span>
        <input type="number" name="precioFinal" required min="0" step="1" class="glass-soft w-full mt-1 h-11 rounded-2xl px-3 text-sm outline-none focus:ring-2 focus:ring-ring" />
      </label>
      <label class="block">
        <span class="font-mono text-[11px] uppercase tracking-wider text-muted-foreground">Enganche</span>
        <input type="number" name="enganche" min="0" step="1" value="0" class="glass-soft w-full mt-1 h-11 rounded-2xl px-3 text-sm outline-none focus:ring-2 focus:ring-ring" />
      </label>
    </div>

    <label class="block">
      <span class="font-mono text-[11px] uppercase tracking-wider text-muted-foreground">Frecuencia de pago</span>
      <select name="frecuenciaPago" required class="glass-soft w-full mt-1 h-11 rounded-2xl px-3 text-sm outline-none focus:ring-2 focus:ring-ring">
        <option>Semanal</option>
        <option>Quincenal</option>
        <option selected>Mensual</option>
        <option>Otro</option>
      </select>
    </label>

    <label class="block">
      <span class="font-mono text-[11px] uppercase tracking-wider text-muted-foreground">Notas</span>
      <textarea name="notas" rows="2" class="glass-soft w-full mt-1 rounded-2xl px-3 py-2 text-sm outline-none focus:ring-2 focus:ring-ring"></textarea>
    </label>

    {result?.error && <p class="text-destructive text-sm">{result.error.message}</p>}
    <button type="submit" class="w-full h-11 rounded-2xl bg-primary text-sm font-bold text-primary-foreground shadow-lg shadow-primary/30">Guardar venta</button>
  </form>
</Base>
