---
import Base from "../layouts/Base.astro";
import { loadLotes, loadVentas, loadAbonos, loadClientes } from "../lib/domain";
import { Dashboard } from "../components/Dashboard";

const [lotes, ventas, abonos, clientes] = await Promise.all([
  loadLotes(), loadVentas(), loadAbonos(), loadClientes(),
]);
---
<Base title="Lotificación — Cumbres de Tiripetío">
  <Dashboard client:only="react" lotes={lotes} ventas={ventas} abonos={abonos} clientes={clientes} />
</Base>
