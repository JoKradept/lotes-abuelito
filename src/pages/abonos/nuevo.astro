---
import Base from "../../layouts/Base.astro";
import { loadVentas, loadClientes, loadAbonos, saldoVenta } from "../../lib/domain";
import { actions } from "astro:actions";
import { pesos } from "../../lib/format";
const [ventas, clientes, abonos] = await Promise.all([loadVentas(), loadClientes(), loadAbonos()]);
const clienteMap = new Map(clientes.map((c) => [c.clienteId, c.nombre]));
const activas = ventas
  .map((v) => ({ v, saldo: saldoVenta(v, abonos) }))
  .filter(({ saldo }) => saldo > 0);
const ventaSel = Astro.url.searchParams.get("ventaId") ?? "";
const result = Astro.getActionResult(actions.crearAbono);
if (result && !result.error) {
  const v = ventas.find((x) => x.ventaId === (result.data.ventaId ?? ventaSel));
  return Astro.redirect(v ? `/lotes/${v.loteId}` : "/ventas");
}
---
<Base title="Nuevo abono">
  <form method="POST" action={actions.crearAbono} class="glass mx-auto max-w-md rounded-3xl p-6 space-y-4">
    <h1 class="text-2xl font-extrabold tracking-tight">Registrar abono</h1>
    {activas.length === 0 ? (
      <p class="text-muted-foreground">No hay ventas con saldo pendiente.</p>
    ) : (
      <>
        <label class="block">
          <span class="font-mono text-[11px] uppercase tracking-wider text-muted-foreground">Venta</span>
          <select name="ventaId" required class="glass-soft w-full mt-1 h-11 rounded-2xl px-3 text-sm outline-none focus:ring-2 focus:ring-ring">
            {activas.map(({ v, saldo }) => (
              <option value={v.ventaId} selected={v.ventaId === ventaSel}>
                {clienteMap.get(v.clienteId) ?? v.clienteId} · Lote {v.loteId} · saldo {pesos(saldo)}
              </option>
            ))}
          </select>
        </label>

        <label class="block">
          <span class="font-mono text-[11px] uppercase tracking-wider text-muted-foreground">Fecha</span>
          <input type="date" name="fecha" required value={new Date().toISOString().slice(0, 10)} class="glass-soft w-full mt-1 h-11 rounded-2xl px-3 text-sm outline-none focus:ring-2 focus:ring-ring" />
        </label>

        <div class="grid grid-cols-2 gap-3">
          <label class="block">
            <span class="font-mono text-[11px] uppercase tracking-wider text-muted-foreground">Monto</span>
            <input type="number" name="monto" required min="1" step="1" class="glass-soft w-full mt-1 h-11 rounded-2xl px-3 text-sm outline-none focus:ring-2 focus:ring-ring" autofocus />
          </label>
          <label class="block">
            <span class="font-mono text-[11px] uppercase tracking-wider text-muted-foreground">Método</span>
            <select name="metodo" required class="glass-soft w-full mt-1 h-11 rounded-2xl px-3 text-sm outline-none focus:ring-2 focus:ring-ring">
              <option>Efectivo</option><option>Transferencia</option><option>Cheque</option><option>Otro</option>
            </select>
          </label>
        </div>

        <label class="block">
          <span class="font-mono text-[11px] uppercase tracking-wider text-muted-foreground">Nota</span>
          <input name="nota" class="glass-soft w-full mt-1 h-11 rounded-2xl px-3 text-sm outline-none focus:ring-2 focus:ring-ring" />
        </label>

        {result?.error && <p class="text-destructive text-sm">{result.error.message}</p>}
        <button type="submit" class="w-full h-11 rounded-2xl bg-primary text-sm font-bold text-primary-foreground shadow-lg shadow-primary/30">Guardar abono</button>
      </>
    )}
  </form>
</Base>
