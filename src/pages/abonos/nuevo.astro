---
import Base from "../../layouts/Base.astro";
import { loadVentas, loadClientes, loadAbonos, saldoVenta } from "../../lib/domain";
import { actions } from "astro:actions";
const [ventas, clientes, abonos] = await Promise.all([loadVentas(), loadClientes(), loadAbonos()]);
const clienteMap = new Map(clientes.map((c) => [c.clienteId, c.nombre]));
const activas = ventas
  .map((v) => ({ v, saldo: saldoVenta(v, abonos) }))
  .filter(({ saldo }) => saldo > 0);
const ventaSel = Astro.url.searchParams.get("ventaId") ?? "";
const result = Astro.getActionResult(actions.crearAbono);
if (result && !result.error) {
  const v = ventas.find((x) => x.ventaId === (result.data.ventaId ?? ventaSel));
  return Astro.redirect(v ? `/lotes/${v.loteId}` : "/ventas");
}
---
<Base title="Nuevo abono">
  <form method="POST" action={actions.crearAbono} class="max-w-md space-y-4">
    <h1 class="text-2xl font-bold">Registrar abono</h1>
    {activas.length === 0 ? (
      <p class="text-neutral-400">No hay ventas con saldo pendiente.</p>
    ) : (
      <>
        <label class="block">
          <span class="text-sm opacity-70">Venta</span>
          <select name="ventaId" required class="w-full mt-1 p-2 bg-neutral-800 rounded">
            {activas.map(({ v, saldo }) => (
              <option value={v.ventaId} selected={v.ventaId === ventaSel}>
                {clienteMap.get(v.clienteId) ?? v.clienteId} · Lote {v.loteId} · saldo ${saldo.toLocaleString("es-MX")}
              </option>
            ))}
          </select>
        </label>

        <label class="block">
          <span class="text-sm opacity-70">Fecha</span>
          <input type="date" name="fecha" required value={new Date().toISOString().slice(0, 10)} class="w-full mt-1 p-2 bg-neutral-800 rounded" />
        </label>

        <label class="block">
          <span class="text-sm opacity-70">Monto</span>
          <input type="number" name="monto" required min="1" step="1" class="w-full mt-1 p-2 bg-neutral-800 rounded" autofocus />
        </label>

        <label class="block">
          <span class="text-sm opacity-70">Método</span>
          <select name="metodo" required class="w-full mt-1 p-2 bg-neutral-800 rounded">
            <option>Efectivo</option><option>Transferencia</option><option>Cheque</option><option>Otro</option>
          </select>
        </label>

        <label class="block">
          <span class="text-sm opacity-70">Nota</span>
          <input name="nota" class="w-full mt-1 p-2 bg-neutral-800 rounded" />
        </label>

        {result?.error && <p class="text-red-400">{result.error.message}</p>}
        <button type="submit" class="w-full py-3 rounded bg-emerald-600 hover:bg-emerald-500 font-semibold">Guardar abono</button>
      </>
    )}
  </form>
</Base>
