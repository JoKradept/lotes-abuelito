---
import "../styles/globals.css";
import { isMotorAvailable } from "../lib/motor";
import { AuthBar } from "../components/AuthBar";
import { LoginWall } from "../components/LoginWall";
const { title = "Lotificación — Cumbres de Tiripetío" } = Astro.props;
const path = Astro.url.pathname;
const SHEET_URL = `https://docs.google.com/spreadsheets/d/${import.meta.env.SHEET_ID}/edit`;
const motorActivo = await isMotorAvailable();
const nav: [string, string, boolean?][] = [
  ["/", "Plano"],
  ["/lotes", "Lotes"],
  ["/ventas", "Ventas"],
  ["/clientes", "Clientes"],
  ["/vendedores", "Vendedores"],
  ["/corte", "Corte"],
  ["/usuarios", "Usuarios"],
  ["http://localhost:3031/studio", "Studio ↗", true],
  [SHEET_URL, "Sheet ↗", true],
];
---
<html lang="es">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{title}</title>
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=IBM+Plex+Mono:wght@400;500;600&display=swap" />
</head>
<body class="relative min-h-screen overflow-x-hidden">
  <LoginWall client:load />
  <div class="pointer-events-none fixed inset-0 -z-10">
    <div class="blob-a absolute -left-32 -top-32 size-[460px] rounded-full bg-primary/30 blur-[130px]"></div>
    <div class="blob-b absolute right-0 top-1/4 size-[420px] rounded-full bg-accent/30 blur-[130px]"></div>
    <div class="blob-a absolute bottom-0 left-1/3 size-[380px] rounded-full bg-disponible/20 blur-[130px]"></div>
  </div>

  <header class="glass sticky top-0 z-30 rounded-none border-x-0 border-t-0">
    <div class="mx-auto flex max-w-[1440px] flex-wrap items-center justify-between gap-4 px-5 py-3 lg:px-8">
      <div class="flex items-center gap-3">
        <div class="grid size-11 place-items-center rounded-2xl bg-primary font-mono text-xs font-bold text-primary-foreground shadow-lg shadow-primary/30">
          LOT
        </div>
        <div class="leading-tight">
          <div class="flex items-center gap-2">
            <p class="text-lg font-extrabold tracking-tight">Lotificación</p>
            {motorActivo ? (
              <span class="inline-flex items-center gap-1.5 rounded-md bg-emerald-50 px-2 py-0.5 font-mono text-[10px] font-semibold text-emerald-700 ring-1 ring-inset ring-emerald-600/20">
                <span class="size-1.5 rounded-full bg-emerald-500 animate-pulse"></span> Motor API
              </span>
            ) : (
              <span class="inline-flex items-center gap-1 rounded-md bg-amber-50 px-2 py-0.5 font-mono text-[10px] font-semibold text-amber-700 ring-1 ring-inset ring-amber-600/20">
                Sheets
              </span>
            )}
          </div>
          <p class="font-mono text-[11px] uppercase tracking-wide text-muted-foreground">Cumbres de Tiripetío · Michoacán</p>
        </div>
      </div>
      <div class="flex flex-wrap items-center gap-3">
        <nav class="flex flex-wrap items-center gap-1.5 font-mono text-xs font-semibold">
          {nav.map(([href, label, external]) => (
            <a href={href} target={external ? "_blank" : undefined} rel={external ? "noopener" : undefined} class={`h-9 rounded-xl px-3 grid place-items-center transition ${path === href ? "bg-primary text-primary-foreground shadow-lg shadow-primary/30" : "glass-soft text-muted-foreground hover:text-foreground"}`}>{label}</a>
          ))}
        </nav>
        <AuthBar client:load />
      </div>
    </div>
  </header>

  <main class="relative mx-auto max-w-[1440px] px-5 py-7 lg:px-8"><slot /></main>
</body>
</html>
